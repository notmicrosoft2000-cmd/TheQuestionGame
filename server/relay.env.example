# The Question Game — relay configuration.
#
# Copy to `relay.env`, fill in RELAY_KEY, and keep it OUT of version control
# (server/relay.env is .gitignore'd). Loaded by the systemd unit.

# --- required: the real Groq key. NEVER commit this file. -------------------
RELAY_KEY=

# --- optional: a shared secret the shipped game sends as X-App-Token. ------
# Set this to make the URL alone useless to anyone who finds it. If you set it,
# the game's config.py RELAY_APP_TOKEN must match.
RELAY_APP_TOKEN=

# --- tuning -----------------------------------------------------------------
RELAY_PORT=8090
RELAY_MODEL=openai/gpt-oss-120b
RELAY_MAX_TOKENS=320
RELAY_RATE=30
RELAY_BURST=10
RELAY_TIMEOUT=20
